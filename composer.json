{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "pushery/fortify-hardening-for-laravel",
  "description": "Stops Laravel Fortify from revealing whether an account exists: neutral answers on registration and password reset, equal timing, and a notice to the owner.",
  "keywords": [
    "laravel",
    "fortify",
    "hardening"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pushery"
    }
  ],
  "type": "library",
  "homepage": "https://github.com/pushery/fortify-hardening-for-laravel",
  "support": {
    "issues": "https://github.com/pushery/fortify-hardening-for-laravel/issues",
    "source": "https://github.com/pushery/fortify-hardening-for-laravel",
    "docs": "https://docs.pushery.com/fortify-hardening-for-laravel/",
    "security": "https://github.com/pushery/fortify-hardening-for-laravel/security/policy"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "laravel/fortify": "^1.0",
    "laravel/framework": "^13.0",
    "symfony/http-foundation": "^7.0 || ^8.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9.3",
    "laravel/ai": "^1.0",
    "laravel/boost": "^2.9",
    "laravel/mcp": "^1.0",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-browser": "^5.0",
    "pestphp/pest-plugin-evals": "^5.1",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "phpstan/phpstan": "^2.3.0",
    "pushery/sqlens-for-laravel": "^0.29",
    "rector/rector": "^2.7.0",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "symfony/yaml": "^7.4.17 || ^8.1.5"
  },
  "autoload": {
    "psr-4": {
      "Pushery\\FortifyHardening\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pushery\\FortifyHardening\\FortifyHardeningServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
